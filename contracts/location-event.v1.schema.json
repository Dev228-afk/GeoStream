{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/geostream/contracts/location-event.v1.schema.json",
  "title": "LocationEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "eventId",
    "deviceId",
    "sequence",
    "routeId",
    "eventTime",
    "producedAt",
    "latitude",
    "longitude",
    "accuracyM"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sequence": { "type": "integer", "minimum": 1 },
    "routeId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "eventTime": { "type": "string", "format": "date-time" },
    "producedAt": { "type": "string", "format": "date-time" },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "accuracyM": { "type": "number", "minimum": 0, "maximum": 200 }
  }
}

